<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color">

    <include
        android:id="@+id/includeTopBar"
        layout="@layout/include_top_bar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/includeTopBar"
        tools:itemCount="3"
        tools:listitem="@layout/rv_app" />

    <TextView
        android:foreground="@drawable/ripple_default"
        android:id="@+id/btnUninstall"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="34dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/shape_btn_uninstall"
        android:gravity="center"
        android:text="@string/uninstall"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>