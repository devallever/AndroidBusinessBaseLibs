<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="50dp">

    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_dialog_light1"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/st_bg_dialog_star2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView10" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="26dp"
        android:src="@drawable/st_bg_dialog_double_aware"
        app:layout_constraintBottom_toBottomOf="@+id/imageView9"
        app:layout_constraintDimensionRatio="h,323:300"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/shapeTextView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="91dp"
        android:fontFamily="@font/nunito_blackitalic"
        android:gravity="center"
        android:text="@string/congratulations"
        android:textColor="#FFC64001"
        android:textSize="23sp"
        android:singleLine="true"
        android:maxLines="1"
        app:autoSizeMaxTextSize="23sp"
        android:ellipsize="end"
        app:autoSizeMinTextSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView7"
        app:layout_constraintTop_toTopOf="@+id/imageView7"
        app:layout_constraintVertical_bias="0.02"
        tools:layout_editor_absoluteX="93dp" />

    <ImageView
        android:id="@+id/bigIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_double_green"
        app:layout_constraintBottom_toBottomOf="@+id/imageView7"
        app:layout_constraintEnd_toEndOf="@+id/imageView7"
        app:layout_constraintHorizontal_bias="0.807"
        app:layout_constraintStart_toStartOf="@+id/imageView7"
        app:layout_constraintTop_toTopOf="@+id/imageView7"
        app:layout_constraintVertical_bias="0.341" />

    <ImageView
        android:id="@+id/limitIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_green"
        app:layout_constraintBottom_toBottomOf="@+id/bigIcon"
        app:layout_constraintEnd_toEndOf="@+id/imageView7"
        app:layout_constraintHorizontal_bias="0.253"
        app:layout_constraintStart_toStartOf="@+id/imageView7" />

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="3dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/ic_double_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/bigIcon"
        app:layout_constraintStart_toEndOf="@+id/limitIcon" />

    <com.step.wincash.ui.widget.ShapeExtraWidthTextView
        android:id="@+id/doubleAwareTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/nunito_blackitalic"
        android:includeFontPadding="false"
        android:textColor="@color/black"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView7"
        app:layout_constraintStart_toStartOf="@+id/bigIcon"
        app:layout_constraintTop_toTopOf="@+id/imageView7"
        app:layout_constraintVertical_bias="0.578"
        app:shape_textEndColor="#FFC60122"
        app:shape_textGradientOrientation="vertical"
        app:shape_textStartColor="#FFF42646"
        app:shape_textStrokeColor="@color/white"
        app:shape_textStrokeSize="1dp"
        tools:text="+5000" />

    <com.step.wincash.ui.widget.ShapeExtraWidthTextView
        android:id="@+id/awareTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-9dp"
        android:fontFamily="@font/nunito_blackitalic"
        android:includeFontPadding="false"
        android:textColor="@color/black"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/doubleAwareTv"
        app:layout_constraintStart_toStartOf="@+id/limitIcon"
        app:shape_textEndColor="#FFC60122"
        app:shape_textGradientOrientation="vertical"
        app:shape_textStartColor="#FFF42646"
        app:shape_textStrokeColor="@color/white"
        app:shape_textStrokeSize="1dp"
        tools:text="+1000" />

    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/seeAdTv"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginHorizontal="55dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/imageView7"
        app:layout_constraintDimensionRatio="h,265:52"
        app:layout_constraintTop_toTopOf="@+id/imageView7"
        app:layout_constraintVertical_bias="0.82"
        app:shape_radius="50dp"
        app:shape_solidGradientEndColor="#FFFA2B04"
        app:shape_solidGradientOrientation="topToBottom"
        app:shape_solidGradientStartColor="#FFFE9D66"
        app:shape_strokeGradientEndColor="#CCFFFFFF"
        app:shape_strokeGradientOrientation="topToBottom"
        app:shape_strokeGradientStartColor="#DBFFFFFF"
        app:shape_shadowColor="@color/color_fff58a34"
        app:shape_shadowOffsetY="8dp"
        app:shape_shadowSize="8dp"
        app:shape_strokeSize="2dp">

        <ImageView
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_dialog_ad" />

        <com.step.wincash.ui.widget.ExtraWidthTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/nunito_blackitalic"
            android:text="@string/get_5"
            android:textColor="@color/white"
            android:textSize="22sp" />
    </com.hjq.shape.layout.ShapeLinearLayout>

    <TextView
        android:id="@+id/getTv"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/get_u"
        android:textColor="#FFCDB59C"
        android:textSize="22sp"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seeAdTv" />

    <com.step.wincash.ui.widget.NativeView
        android:id="@+id/naviteView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/imageView7"/>
</androidx.constraintlayout.widget.ConstraintLayout>