<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/highLightView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.plinkopro.wincash.ui.widget.FingerAnimationView
        android:id="@+id/fingerView"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:layout_marginStart="-25dp"
        android:layout_marginTop="-20dp"
        app:layout_constraintStart_toEndOf="@+id/highLightView"
        app:layout_constraintTop_toBottomOf="@+id/highLightView" />

    <com.hjq.shape.view.ShapeView
        android:id="@+id/shapeView"
        android:layout_width="2dp"
        android:layout_height="92dp"
        app:layout_constraintEnd_toEndOf="@+id/view"
        app:layout_constraintStart_toStartOf="@+id/view"
        app:shape_solidColor="#FFCECDBF"
        app:layout_constraintTop_toBottomOf="@+id/view"/>

    <com.hjq.shape.view.ShapeView
        android:id="@+id/view"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/highLightView"
        app:layout_constraintStart_toStartOf="@+id/highLightView"
        app:layout_constraintTop_toBottomOf="@+id/highLightView"
        app:shape_radius="10dp"
        app:shape_solidColor="#FFCECDBF" />


    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/ivTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="@font/nunito_regular"
        android:gravity="center"
        android:padding="30dp"
        android:text="@string/withdraw_now"
        android:textColor="#FF342C29"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/shapeView"
        app:shape_radius="20dp"
        app:shape_solidColor="#FFFFFAEF"
        app:shape_strokeColor="#99FDC16B"
        app:shape_strokeSize="2dp"
        tools:layout_editor_absoluteX="-20dp" />


</androidx.constraintlayout.widget.ConstraintLayout>