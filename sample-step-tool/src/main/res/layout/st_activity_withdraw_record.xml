<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white">

    <View
        android:id="@+id/topBarBg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="7dp"
        android:foreground="@drawable/ripple_effect_circle"
        android:padding="9dp"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="@+id/topBarBg"
        app:layout_constraintStart_toStartOf="@+id/topBarBg"
        app:layout_constraintTop_toTopOf="@+id/topBarBg" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/ExtraBoldText"
        android:text="@string/record"
        android:textColor="@color/color_333333"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/topBarBg"
        app:layout_constraintEnd_toEndOf="@+id/topBarBg"
        app:layout_constraintStart_toStartOf="@+id/topBarBg"
        app:layout_constraintTop_toTopOf="@+id/topBarBg" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWithdrawRecord"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:itemCount="3"
        tools:listitem="@layout/rv_withdraw_record"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarBg" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/networkErrorLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarBg">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="-100dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="181dp"
                android:layout_height="117dp"
                android:src="@drawable/ic_network_error" />

            <TextView
                style="@style/SemiBoldText"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="@string/network_error_tips"
                android:textColor="@color/color_342C29"
                android:textSize="16sp" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnRetry"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:layout_marginTop="31dp"
                android:background="@drawable/bg_network_retry">

                <ImageView
                    android:id="@+id/ivRefresh"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="2dp"
                    android:src="@drawable/ic_network_retry"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvRefresh"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvRefresh"
                    style="@style/BoldText"
                    android:layout_marginHorizontal="2dp"
                    android:text="@string/refresh"
                    android:textColor="@color/color_342C29"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivRefresh"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>