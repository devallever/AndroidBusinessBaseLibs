<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/bg_withdraw_dialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_margin="4dp"
            android:id="@+id/close_iv"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:foreground="@drawable/ripple_effect_circle"
            android:padding="10dp"
            android:src="@drawable/ic_withdraw_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvTitle"
            style="@style/DialogTitleTextStyle"
            android:layout_marginTop="64dp"
            android:text="@string/authentication"
            android:textColor="@color/color_974901"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:shape_solidColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center">

                    <com.plinkopro.wincash.business.withdraw.CaptchaView
                        android:id="@+id/captchaContent"
                        android:layout_width="0dp"
                        android:layout_height="63dp"
                        android:layout_weight="1"
                        app:captchaBorderColor="#DEDEDE"
                        app:captchaBorderWidth="2dp"
                        app:captchaCornerRadius="12dp"
                        app:captchaFontSize="28sp" />


                    <TextView
                        android:id="@+id/tv_renew"
                        style="@style/RegularText"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="2dp"
                        android:text="@string/renew"
                        android:textColor="@color/color_333333"
                        android:textSize="15sp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/et_input"
                    style="@style/DialogInputTextStyle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:hint="@string/input_captcha_hint"
                    android:inputType="number"
                    android:paddingHorizontal="22dp"
                    android:textColorHint="@color/color_66342C29"
                    android:textColor="@color/color_342C29"
                    app:shape_strokeSize="2dp"
                    app:shape_radius="8dp"
                    app:shape_strokeColor="#DEDEDE"/>

                <com.hjq.shape.view.ShapeTextView
                    android:id="@+id/tv_submit"
                    style="@style/DialogButtonTextStyle"
                    android:layout_width="wrap_content"
                    android:minWidth="140dp"
                    android:maxWidth="280dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="30dp"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@string/txt_lotto_submit"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="18sp"
                    android:paddingHorizontal="2dp"
                    app:shape_radius="27dp"
                    app:shape_shadowColor="@color/color_F0B885"
                    app:shape_shadowOffsetY="10dp"
                    app:shape_shadowSize="10dp"
                    app:shape_solidGradientEndColor="@color/color_FA2B04"
                    app:shape_solidGradientOrientation="topToBottom"
                    app:shape_solidGradientStartColor="@color/color_FE9D66"
                    app:shape_strokeColor="@color/white"
                    app:shape_strokeSize="2dp" />

            </LinearLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:src="@drawable/ic_not_suficient_top_bg"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>