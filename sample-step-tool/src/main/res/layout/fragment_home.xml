<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/homeMain"
    android:background="@drawable/bg_home">

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="17dp">

        <com.step.wincash.ui.widget.CurrencyView
            android:id="@+id/currencyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"/>

        <ImageView
            android:id="@+id/ivSetting"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_gravity="start"
            android:src="@drawable/ic_setting" />
    </FrameLayout>

    <com.hjq.shape.layout.ShapeLinearLayout
        android:id="@+id/btnRequestPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout"
        app:shape_radius="16dp"
        app:shape_solidColor="#4D303030"
        tools:layout_editor_absoluteX="17dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_perssion_tips" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/get_step_perssion"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </com.hjq.shape.layout.ShapeLinearLayout>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tvStepCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="71dp"
        android:fontFamily="@font/nunito_black"
        android:textColor="#FF087318"
        android:textSize="37.28sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout"
        tools:text="0" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStepCount">

        <TextView
            android:id="@+id/tvStepGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/target_step_count"
            android:textColor="#FF087318"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnSetGoal"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_goal_setting" />

    </LinearLayout>

    <ImageView
        android:id="@+id/goldBubbleImg1"
        android:layout_width="54dp"
        android:layout_height="53dp"
        android:layout_marginStart="31dp"
        android:src="@drawable/ic_bubble_gold"
        app:layout_constraintBottom_toTopOf="@+id/goldBubbleImg2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRequestPermission" />

    <ImageView
        android:id="@+id/goldBubbleImg2"
        android:layout_width="54dp"
        android:layout_height="53dp"
        android:layout_marginStart="3dp"
        android:src="@drawable/ic_bubble_gold"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
        app:layout_constraintStart_toStartOf="@+id/goldBubbleImg1"
        app:layout_constraintTop_toBottomOf="@+id/goldBubbleImg1" />

    <com.tencent.qgame.animplayer.AnimView
        android:id="@+id/stepVideo"
        android:layout_width="182dp"
        android:layout_height="206dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <ImageView
        android:id="@+id/greenBubbleImg1"
        android:layout_width="54dp"
        android:layout_height="53dp"
        android:layout_marginEnd="37dp"
        android:src="@drawable/ic_bubble_green"
        app:layout_constraintBottom_toTopOf="@+id/greenBubbleImg2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRequestPermission" />

    <ImageView
        android:id="@+id/greenBubbleImg2"
        android:layout_width="54dp"
        android:layout_height="53dp"
        android:layout_marginEnd="19dp"
        android:src="@drawable/ic_bubble_green"
        app:layout_constraintBottom_toTopOf="@+id/greenBubbleImg3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greenBubbleImg1" />

    <ImageView
        android:id="@+id/greenBubbleImg3"
        android:layout_width="54dp"
        android:layout_height="53dp"
        android:layout_marginEnd="56dp"
        android:src="@drawable/ic_bubble_green"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greenBubbleImg2" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_step_info_ly"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintDimensionRatio="h,355:47"
        app:layout_constraintTop_toBottomOf="@+id/stepVideo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView13"
                android:layout_width="16dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_km"
                app:layout_constraintEnd_toStartOf="@+id/tvDistance"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@+id/textView2"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imageView13"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1.25" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvDistance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvDistance"
                tools:layout_editor_absoluteY="3dp"
                android:text="km" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView14"
                android:layout_width="16dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_time"
                app:layout_constraintEnd_toStartOf="@+id/tvTime"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imageView14"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="00.00" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView15"
                android:layout_width="16dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_cal"
                app:layout_constraintEnd_toStartOf="@+id/tvKcal"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvKcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@+id/textView3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imageView15"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="42.25" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvKcal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvKcal"
                tools:layout_editor_absoluteY="3dp"
                android:text="cal" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <ImageView
        android:id="@+id/interactAdImg1"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_interact1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3" />

    <ImageView
        android:id="@+id/interactAdImg2"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_interact2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3" />

    <ImageView
        android:id="@+id/imageView16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/bg_home_bt_ly"
        app:layout_constraintDimensionRatio="h,201:77"
        app:layout_constraintEnd_toStartOf="@+id/interactAdImg2"
        app:layout_constraintStart_toEndOf="@+id/interactAdImg1"
        app:layout_constraintTop_toTopOf="@+id/interactAdImg1" />

    <LinearLayout
        android:id="@+id/getCoinsLL"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/imageView16"
        app:layout_constraintEnd_toEndOf="@+id/imageView16"
        app:layout_constraintStart_toStartOf="@+id/imageView16"
        app:layout_constraintTop_toTopOf="@+id/imageView16">

        <ImageView
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_dialog_ad" />

        <com.step.wincash.ui.widget.ShapeExtraWidthTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/nunito_blackitalic"
            android:lines="1"
            android:text="@string/get_coins"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="16sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/goToLuckyWheelImg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="13dp"
        android:src="@drawable/bg_lucky_wheel_ly"
        app:layout_constraintDimensionRatio="h,171:77"
        app:layout_constraintEnd_toStartOf="@+id/goToScratchImg"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/goToScratchImg" />

    <ImageView
        android:id="@+id/goToScratchImg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_scratch_ly"
        android:layout_marginEnd="10dp"
        app:layout_constraintDimensionRatio="h,171:77"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_weight="1"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toEndOf="@+id/goToLuckyWheelImg"
        app:layout_constraintTop_toBottomOf="@+id/imageView16" />

    <com.step.wincash.ui.widget.FingerAnimationView
        android:id="@+id/fingerView"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="-23dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/imageView16"
        app:layout_constraintTop_toTopOf="@+id/imageView16" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/danmu"
        android:layout_width="343dp"
        android:layout_height="46dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_danmu"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivPayment"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_pay_paypal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvId"
            style="@style/RegularText"
            android:layout_marginStart="4dp"
            android:text="ID:AS34SL"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/tvDanmuMessage"
            app:layout_constraintStart_toEndOf="@+id/ivPayment"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvDanmuMessage"
            style="@style/RegularText"
            android:layout_marginStart="4dp"
            android:text="@string/danmu_message"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPayment"
            app:layout_constraintTop_toBottomOf="@+id/tvId" />


        <TextView
            android:id="@+id/tvDanmuTime"
            style="@style/RegularText"
            android:layout_marginStart="4dp"
            android:text="2025-10-27"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="13dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>