<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_lucky_wheel">

    <FrameLayout
        android:id="@+id/topBarFl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backImg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back_white" />

        <com.step.wincash.ui.widget.CurrencyView
            android:id="@+id/currencyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:layout_gravity="end|center_vertical" />

    </FrameLayout>

    <ImageView
        android:layout_width="35dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_money"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarFl" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/shapeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="23dp"
        android:fontFamily="@font/nunito_blackitalic"
        android:gravity="center"
        android:shadowColor="#FF4ABDDB"
        android:shadowDy="8"
        android:shadowRadius="16"
        android:text="Lucky Wheel"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/topBarFl"
        tools:layout_editor_absoluteX="23dp" />

    <com.step.wincash.ui.widget.LuckyWheelView
        android:id="@+id/luckyWheelView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/shapeTextView"
        android:layout_marginTop="-10dp"/>

    <com.step.wincash.ui.widget.BannerNativeView
        android:id="@+id/bannerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
