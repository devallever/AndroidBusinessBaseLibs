<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="32dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:background="@drawable/st_bg_withdraw_dialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_withdraw_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/shapeTextView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="19dp"
            android:fontFamily="@font/nunito_blackitalic"
            android:gravity="center"
            android:text="@string/edit_step_goal"
            android:textColor="#FF974901"
            android:textSize="24sp"
            app:layout_constraintTop_toBottomOf="@+id/iv_close"
            tools:layout_editor_absoluteX="19dp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/topSeekbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            android:max="20"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:progressDrawable="@null"
            android:splitTrack="false"
            android:thumb="@drawable/ic_progrees_thumb"
            android:thumbOffset="29dp"
            app:layout_constraintTop_toBottomOf="@+id/shapeTextView6"/>

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/shapeTextView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black"
            android:text="0"
            android:textColor="#FF974901"
            app:layout_constraintBottom_toBottomOf="@+id/topSeekbar"
            app:layout_constraintStart_toStartOf="@+id/frameLayout3" />

        <com.hjq.shape.view.ShapeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black"
            android:text="20000"
            android:textColor="#FF974901"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toBottomOf="@+id/topSeekbar"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/frameLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/seekBar"
            app:layout_constraintTop_toBottomOf="@+id/topSeekbar">

            <com.hjq.shape.view.ShapeView
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_gravity="center"
                app:shape_radius="5dp"
                app:shape_solidColor="#FFDAB28E" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/centerSeekbar"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:enabled="false"
                android:focusable="false"
                android:max="20"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/st_progress"
                android:splitTrack="false"
                android:thumb="@null" />

            <com.hjq.shape.view.ShapeView
                android:layout_width="13dp"
                android:layout_height="13dp"
                app:shape_radius="50dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#FF974901"
                app:shape_strokeSize="1.72dp" />

            <com.hjq.shape.view.ShapeView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="end"
                app:shape_radius="50dp"
                app:shape_solidColor="@color/white"
                app:shape_strokeColor="#FF974901"
                app:shape_strokeSize="1.72dp" />
        </FrameLayout>


        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="26dp"
            android:max="20"
            android:min="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:progressDrawable="@null"
            android:splitTrack="false"
            android:thumb="@drawable/ic_thumb2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topSeekbar" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/stepNumTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_black"
            android:textColor="#FF974901"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seekBar"
            app:shape_radius="50dp"
            app:shape_solidColor="#FFF5E4C3" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/makeSureTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="22dp"
            android:fontFamily="@font/nunito_blackitalic"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/make_sure"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:shape_shadowColor="#FFD7CCB7"
            app:shape_shadowSize="4dp"
            app:shape_shadowOffsetY="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stepNumTv"
            app:shape_radius="50dp"
            app:shape_solidGradientEndColor="#FF29A140"
            app:shape_solidGradientOrientation="topToBottom"
            app:shape_solidGradientStartColor="#FF48CA61"
            app:shape_strokeColor="#DBFFFFFF"
            app:shape_strokeSize="2dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_set_step"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>