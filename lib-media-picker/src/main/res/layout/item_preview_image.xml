<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 图片（支持手势缩放） -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- 视频播放区域 -->
    <FrameLayout
        android:id="@+id/layoutVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- 视频画面（居中） -->
        <VideoView
            android:id="@+id/videoPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- 播放/暂停大按钮（居中） -->
        <ImageView
            android:id="@+id/btnVideoPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_media_picker_play_video"
            android:contentDescription="播放/暂停" />


        <!-- 底部控制栏 -->
        <LinearLayout
            android:id="@+id/layoutVideoControls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="#99000000">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="00:00" />

            <SeekBar
                android:id="@+id/seekBarVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVideoTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="00:00" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
