<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Tab 栏：媒体类型切换 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutType"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:tabIndicatorColor="@color/media_picker_primary"
        app:tabSelectedTextColor="@color/media_picker_primary"
        app:tabTextColor="@color/media_picker_text_secondary"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextAppearance="@style/MediaPickerTabTextStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 目录栏：当前目录名 + 下拉箭头 -->
    <LinearLayout
        android:id="@+id/layoutDirectoryBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FAFAFA"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDirectoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="全部目录"
            android:textSize="15sp"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="middle" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_media_picker_arrow_down"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- 内容区域：ViewPager2（左右滑动切换 Tab） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutDirectoryBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部已选预览条 -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EEEEEE" />

        <!-- 已选预览横向列表 -->
        <HorizontalScrollView
            android:id="@+id/scrollSelected"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:scrollbars="none"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutSelectedItems"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:paddingStart="12dp" />
        </HorizontalScrollView>

        <!-- 底部操作栏：确认 + 计数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvSelectCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已选 0/9"
                android:textSize="14sp"
                android:textColor="#666666" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirm"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:text="确定"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_media_picker_btn_confirm" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
