<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高级用法"
            android:textColor="@android:color/black"
            android:textSize="20sp" />

        <!-- 1. 不使用缓存 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. 不使用缓存 (CachePolicy.NONE)"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/ivNoCache"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop" />

        <!-- 2. 仅内存缓存 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. 仅内存缓存 (MEMORY_ONLY)"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/ivMemOnly"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop" />

        <!-- 3. 带事件监听器 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. 带事件监听器"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/ivListener"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop" />

        <!-- 4. 回调模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4. 回调模式 (intoCallback)"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvCallbackHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="点击下方按钮通过回调获取 Bitmap"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnCallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:text="回调加载图片"
            android:textSize="14sp" />

        <!-- 5. 清除 / 取消 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="5. 清除 / 取消"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/ivCancel"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop" />
        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp"
            android:paddingHorizontal="24dp"
            android:text="清除该图片"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
