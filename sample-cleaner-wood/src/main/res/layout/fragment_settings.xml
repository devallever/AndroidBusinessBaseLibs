<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color">

    <include
        android:id="@+id/includeTopBar"
        layout="@layout/include_top_bar" />


    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="92dp"
        android:src="@drawable/ic_loading_logo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/includeTopBar" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

    <View
        android:id="@+id/itemRateUsContainer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/shape_list_item_bg"
        android:foreground="@drawable/ripple_default_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppName" />

    <View
        android:id="@+id/itemPrivacyContainer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/shape_list_item_bg"
        android:foreground="@drawable/ripple_default_white"
        app:layout_constraintTop_toBottomOf="@+id/itemRateUsContainer"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageView
        android:id="@+id/ivRateUs"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/ic_rate_us"
        app:layout_constraintBottom_toBottomOf="@+id/itemRateUsContainer"
        app:layout_constraintLeft_toLeftOf="@+id/itemRateUsContainer"
        app:layout_constraintTop_toTopOf="@+id/itemRateUsContainer" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:text="@string/rate_us"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/itemRateUsContainer"
        app:layout_constraintLeft_toRightOf="@+id/ivRateUs"
        app:layout_constraintTop_toTopOf="@+id/itemRateUsContainer" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="@+id/itemRateUsContainer"
        app:layout_constraintRight_toRightOf="@+id/itemRateUsContainer"
        app:layout_constraintTop_toTopOf="@+id/itemRateUsContainer" />


    <ImageView
        android:id="@+id/ivPrivacy"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/ic_privacy"
        app:layout_constraintBottom_toBottomOf="@+id/itemPrivacyContainer"
        app:layout_constraintLeft_toLeftOf="@+id/itemPrivacyContainer"
        app:layout_constraintTop_toTopOf="@+id/itemPrivacyContainer" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:text="@string/privacy"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/itemPrivacyContainer"
        app:layout_constraintLeft_toRightOf="@+id/ivPrivacy"
        app:layout_constraintTop_toTopOf="@+id/itemPrivacyContainer" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="16dp"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="@+id/itemPrivacyContainer"
        app:layout_constraintRight_toRightOf="@+id/itemPrivacyContainer"
        app:layout_constraintTop_toTopOf="@+id/itemPrivacyContainer" />
</androidx.constraintlayout.widget.ConstraintLayout>