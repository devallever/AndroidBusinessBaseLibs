<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/default_background">

	<!-- 标题栏 -->
	<RelativeLayout
		android:id="@+id/top_bar"
		android:layout_width="match_parent"
		android:layout_height="@dimen/default_top_bar_height"
		android:background="@drawable/top_bar_bg">

		<ImageView
			android:id="@+id/sa_iv_back"
			android:layout_width="@dimen/default_icon_width"
			android:layout_height="@dimen/default_icon_height"
			android:layout_centerVertical="true"
			android:src="@drawable/icon_back"
			android:tint="@color/default_icon_color_filter"
			android:scaleType="centerInside"/>

		<!-- 标题 -->
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_toEndOf="@+id/sa_iv_back"
			android:layout_centerVertical="true"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<TextView
				android:id="@+id/tv_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text=""
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="@color/top_bar_tv_title_color"/>
		</LinearLayout>

		<ImageView
			android:id="@+id/iv_right"
			android:layout_width="@dimen/default_icon_height"
			android:layout_height="@dimen/default_icon_width"
			android:scaleType="centerInside"
			android:layout_alignParentEnd="true"
			android:layout_centerVertical="true"
			android:tint="@color/default_icon_color_filter"
			android:visibility="gone"/>
	</RelativeLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:layout_below="@+id/top_bar"
		android:paddingStart="20dp"
		android:paddingEnd="20dp"
		tools:ignore="RtlSymmetry">

		<TextView
			style="@style/setting_item"
			android:id="@+id/setting_tv_modify_password"
			android:text="@string/setting_modify_password"
			android:drawableEnd="@drawable/setting_icon_password"/>

		<include layout="@layout/include_divider_line"/>

		<TextView
			style="@style/setting_item"
			android:id="@+id/setting_tv_feedback"
			android:text="@string/feedback"
			android:drawableEnd="@drawable/setting_icon_feedback"/>

		<include layout="@layout/include_divider_line"/>

		<TextView
			style="@style/setting_item"
			android:id="@+id/setting_tv_about"
			android:text="@string/about"
			android:drawableEnd="@drawable/icon_setting_about"/>

		<include layout="@layout/include_divider_line"/>


	</LinearLayout>

</RelativeLayout>