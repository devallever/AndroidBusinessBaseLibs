<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@color/black">

    <ImageView
        android:layout_width="170dp"
        android:layout_height="118dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_dialog_select" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="61dp"
            android:orientation="vertical"
            app:shape_radius="30dp"
            app:shape_solidColor="@color/white">

            <com.hjq.shape.view.ShapeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="@string/apply_success"
                android:textColor="@color/color_bf6b17"
                android:textSize="18sp"
                android:textStyle="bold"
                app:shape_radiusInTopEnd="30dp"
                app:shape_radiusInTopStart="30dp"
                app:shape_solidColor="#FFF6E2" />

            <TextView
                android:id="@+id/titleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/withdraw_apply_success"
                android:textSize="20sp"
                android:textColor="@color/color_333333"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginTop="70dp"
                android:layout_marginBottom="48dp"
                android:layout_marginHorizontal="30dp" />

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/okTv"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/ok"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/pre"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_radius="50dp"
                android:layout_marginBottom="30dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                android:paddingHorizontal="2dp"
                android:layout_gravity="center_horizontal"
                app:shape_solidGradientEndColor="@color/color_FE9B4F"
                app:shape_solidGradientStartColor="@color/color_FFAB37" />

        </com.hjq.shape.layout.ShapeLinearLayout>

        <ImageView
            android:id="@+id/close_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_close" />

    </LinearLayout>

</FrameLayout>