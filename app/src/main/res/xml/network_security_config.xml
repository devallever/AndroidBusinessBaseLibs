<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许明文 HTTP 通信（用于局域网/调试环境） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" /> <!-- 允许信任用户证书，方便测试 -->
        </trust-anchors>
    </base-config>

    <!-- 针对 Unity 中国区域名的特殊配置，豁免证书校验（仅限测试阶段） -->
    <domain-config>
        <domain includeSubdomains="true">unitychina.cn</domain>
        <domain includeSubdomains="true">unity3d.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
