<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/setting_tv_permission"
            style="@style/vc_setting_item"
            android:drawableEnd="@drawable/vc_ic_arrow"
            android:text="@string/vc_permission_setting" />

        <include layout="@layout/vc_include_divider_line" />

        <TextView
            android:id="@+id/setting_tv_share"
            style="@style/vc_setting_item"
            android:drawableEnd="@drawable/vc_ic_share"
            android:text="@string/vc_share" />

        <include layout="@layout/vc_include_divider_line" />

        <TextView
            android:id="@+id/setting_tv_feedback"
            style="@style/vc_setting_item"
            android:drawableEnd="@drawable/vc_ic_feedback"
            android:text="@string/vc_feedback" />

        <include layout="@layout/vc_include_divider_line" />

        <TextView
            android:id="@+id/setting_tv_about"
            style="@style/vc_setting_item"
            android:drawableEnd="@drawable/vc_ic_about"
            android:text="@string/vc_about" />

        <include layout="@layout/vc_include_divider_line" />

        <TextView
            android:id="@+id/setting_tv_support"
            style="@style/vc_setting_item"
            android:drawableEnd="@drawable/vc_ic_support"
            android:text="@string/vc_support"
            android:visibility="visible"/>

        <include layout="@layout/vc_include_divider_line"
            android:visibility="visible"/>

        <FrameLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <FrameLayout
            android:id="@+id/nativeAdContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"/>

    </LinearLayout>

</RelativeLayout>