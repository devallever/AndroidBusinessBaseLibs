<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_default_gray">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/vc_setting_item_container_style">

            <TextView
                style="@style/vc_setting_item_label_style"
                android:text="@string/countdown" />

            <EditText
                android:id="@+id/setting_item_et_time"
                style="@style/vc_input_et_bar_et_style"
                android:hint="秒"
                android:inputType="number"
                android:maxLength="2" />
        </LinearLayout>

        <include layout="@layout/vc_include_divider_line" />


        <LinearLayout style="@style/vc_setting_item_container_style">

            <TextView
                style="@style/vc_setting_item_label_style"
                android:text="@string/phone" />

            <EditText
                android:id="@+id/setting_item_et_phone"
                style="@style/vc_input_et_bar_et_style"
                android:hint="@string/phone"
                android:inputType="number"
                android:maxLength="20" />
        </LinearLayout>

        <include layout="@layout/vc_include_divider_line" />


        <LinearLayout style="@style/vc_setting_item_container_style">

            <TextView
                style="@style/vc_setting_item_label_style"
                android:text="@string/contact" />

            <EditText
                android:id="@+id/setting_item_et_contact"
                style="@style/vc_input_et_bar_et_style"
                android:hint="姓名" />
        </LinearLayout>

        <include layout="@layout/vc_include_divider_line" />

        <LinearLayout style="@style/vc_setting_item_container_style">

            <TextView
                style="@style/vc_setting_item_label_style"
                android:text="@string/place" />

            <EditText
                android:id="@+id/setting_item_et_local"
                style="@style/vc_input_et_bar_et_style"
                android:hint="@string/place" />
        </LinearLayout>

        <include layout="@layout/vc_include_divider_line" />


        <LinearLayout
            style="@style/vc_setting_item_container_style"
            android:background="@color/vc_default_gray">

            <TextView
                android:id="@+id/tvChooseContact"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/select_contact"
                android:textColor="@color/vc_default_theme_color"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include layout="@layout/vc_include_divider_line" />

        <LinearLayout
            style="@style/vc_setting_item_container_style"
            android:background="@color/white">

            <TextView
                style="@style/vc_setting_item_label_style"
                android:text="@string/vc_advanced_setting" />

            <TextView
                android:id="@+id/setting_item_advanced"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:drawableEnd="@drawable/vc_ic_arrow"
                android:gravity="center|end"
                android:text="铃声/震动/壁纸/重复"></TextView>
        </LinearLayout>

        <include layout="@layout/vc_include_divider_line" />

        <FrameLayout
            android:id="@+id/banner_container"
            style="@style/vc_setting_item_container_style"
            android:background="@color/vc_default_gray"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/setting_btn_start"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="10dp"
        android:background="@drawable/vc_btn_start_bg"
        android:gravity="center"
        android:text="@string/escape_now"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
		android:layout_alignParentEnd="true"
        android:id="@+id/ivSetting"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_above="@+id/setting_btn_start"
        android:layout_marginBottom="30dp"
        android:background="@drawable/vc_btn_white_round"
        android:elevation="30dp"
        android:scaleType="centerInside"
        android:src="@drawable/vc_ic_setting"
		android:layout_marginEnd="16dp"
        android:textSize="18sp"
        android:tint="@color/black" />

	<ImageView
		android:id="@+id/ivGuide"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:layout_above="@+id/setting_btn_start"
		android:layout_toLeftOf="@+id/ivSetting"
		android:layout_marginEnd="20dp"
		android:layout_marginBottom="30dp"
		android:background="@drawable/vc_btn_white_round"
		android:elevation="30dp"
		android:scaleType="centerInside"
		android:src="@drawable/vc_ic_tab_guide"
		android:textSize="18sp"
		android:tint="@color/black" />


</RelativeLayout>