<?xml version="1.0" encoding="utf-8"?>
<com.photoeditor.ui.view.PrivacyCheckView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_bg">

    <!--<com.photoeditor.ui.view.TextureVideoView-->
    <!--android:id="@+id/videoview"-->
    <!--android:layout_width="match_parent"-->
    <!--android:layout_height="match_parent"-->
    <!--/>-->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/privacy_bg" />


    <LinearLayout
        android:id="@+id/ll_bottom_privacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tv_copyright"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_check_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:padding="5dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/privacy_icon_choose" />

        <TextView
            android:id="@+id/tv_privacy_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="@string/privacy_message_pre"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_check_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:singleLine="true"
            android:text="@string/privacy_message"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:text="@string/copy_right_info"
        android:textColor="#80ffffff"
        android:textSize="9sp" />

    <Button
        android:id="@+id/btn_privacy_check"
        android:layout_width="254dp"
        android:layout_height="66dp"
        android:layout_above="@+id/ll_bottom_privacy"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/privacy_button"
        android:text="@string/privacy_start"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />
</com.photoeditor.ui.view.PrivacyCheckView>