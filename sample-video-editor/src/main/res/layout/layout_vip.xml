<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/fl_banner"
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <include
                android:id="@+id/mediaView"
                layout="@layout/layout_media_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerInside"
                android:alpha="0.3"
                android:src="@drawable/icon_premium_close" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/ll_banner1"
            android:layout_marginTop="200dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:gravity="center">

            <com.qrcode.scanner.ui.widget.BlurImageView
                android:id="@+id/iv_banner1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                />

            <com.qrcode.scanner.ui.widget.BlurImageView
                android:id="@+id/iv_banner2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                 />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/v_space1"
        android:layout_width="match_parent"
        android:layout_height="20dp" />
    <View
        android:id="@+id/v_space2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="40dp"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/tv_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/app_name"
            android:textColor="#80ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/tv_scan"
            android:src="@drawable/icon_premium_tip" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_scan"
            android:layout_centerVertical="true"
            android:text="@string/vip_tip"
            android:textColor="#80ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_month"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_month"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:button="@null"
            android:drawableStart="@drawable/rb_premium_selector"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_month_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_month_tip"
                    android:textColor="@color/premium_normal_title_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_month_desp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_month_title"
                    android:paddingTop="3dp"
                    android:text="@string/vip_month_tip2"
                    android:textColor="@color/premium_normal_desp_gray"
                    android:textSize="10sp" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_year"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_year"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:button="@null"
            android:checked="true"
            android:drawableStart="@drawable/rb_premium_selector"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_year_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_year_tip"
                    android:textColor="@color/premium_check_title_gray"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_year_desp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_year_title"
                    android:paddingTop="3dp"
                    android:text="@string/vip_year_tip2"
                    android:textColor="@color/premium_check_desp_gray"
                    android:textSize="10sp" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/v_space"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:visibility="gone"/>
    <FrameLayout
        android:id="@+id/ll_buy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_gravity="center_horizontal">
        <com.android.absbase.ui.widget.RippleTextView
            android:id="@+id/btn_continue_buy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_btn_rectangle_round"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="@string/premium_start_buy"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/premium_icon_03"
            android:layout_marginEnd="20dp"
            android:layout_gravity="end|center"
            />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/ll_bottom_privacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_privacy_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="sans-serif"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="@string/privacy_message_pre"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_check_privacy"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:singleLine="true"
            android:text="@string/privacy_message"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>