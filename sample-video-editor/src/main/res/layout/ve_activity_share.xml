<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/share_save_background"
    android:orientation="vertical">

    <!--- title bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_title_height"
        android:background="@color/title_bar_color">

        <com.android.absbase.ui.widget.RippleImageView
            android:id="@+id/iv_back"
            style="@style/default_icon_style"
            android:src="@drawable/icon_back" />

        <TextView
            style="@style/title_bar_title_style"
            android:text="@string/share_save_title"/>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 显示区 -->
            <FrameLayout
                android:layout_width="@dimen/share_save_display_content_width"
                android:layout_height="@dimen/share_save_display_content_height"
                android:layout_marginTop="@dimen/share_save_display_content_margin_top"
                android:background="@drawable/share_save_content_frame"
                android:padding="@dimen/share_save_display_content_padding">

                <VideoView
                    android:id="@+id/video_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/iv_play"
                    android:layout_width="@dimen/share_save_btn_play_width"
                    android:layout_height="@dimen/share_save_btn_play_height"
                    android:layout_gravity="center"
                    android:background="@drawable/share_save_play_btn_bg"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_album_preview_play" />

            </FrameLayout>

            <!-- 分享 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_share"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/share_save_share_container_height"
                android:layout_marginTop="@dimen/share_save_share_container_margin_top" />
        </LinearLayout>


    </ScrollView>

</LinearLayout>