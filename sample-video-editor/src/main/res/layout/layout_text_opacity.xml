<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:orientation="vertical">


    <com.allever.video.editor.ui.widget.CircleSeekBar
        android:id="@+id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        custom:nummax="100"
        custom:numSize="14sp"
        custom:numprogress="50"
        custom:numshowNum="false" />

    <TextView
        android:id="@+id/textview"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/video_edit_bottom_item_font_opacity_text"
        android:textColor="@color/video_edit_bottom_text_color"
        android:textSize="12sp" />

</LinearLayout>