<?xml version="1.0" encoding="utf-8"?>
<com.android.absbase.ui.widget.RippleRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="5dp"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:singleLine="true"
        android:textColor="@color/video_edit_bottom_music_online_text_color"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/download_view"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:scaleType="centerInside"
        android:src="@drawable/icon_edit_online_download"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/newflag_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone" />


    <ImageView
        android:id="@+id/iv_crown"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:scaleType="centerInside"
        android:src="@drawable/icon_crown"
        android:visibility="gone" />


    <View
        android:id="@+id/mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/video_edit_bottom_mask_color"
        android:visibility="gone"/>

    <include layout="@layout/layout_progress"/>

</com.android.absbase.ui.widget.RippleRelativeLayout>
