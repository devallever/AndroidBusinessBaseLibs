<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_bg"
    android:orientation="vertical">

    <!--- title bar -->
    <RelativeLayout
        android:id="@+id/rl_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_title_height"
        android:background="@color/title_bar_color">

        <com.android.absbase.ui.widget.RippleImageView
            android:id="@+id/iv_close"
            style="@style/default_icon_style"
            android:src="@drawable/icon_back"/>

        <TextView
            style="@style/title_bar_title_style"
            android:text="@string/premium_title" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/svip_banner">

    </FrameLayout>

    <!--<ImageView-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="wrap_content"-->
        <!--android:background="@drawable/svip_banner"/>-->

    <!--<View-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="30dp" />-->


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_1" />

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_2" />

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_3" />

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_4" />

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_5" />

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_6" />

            <TextView
                style="@style/premium_item"
                android:text="@string/premium_description_7" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>