<?xml version="1.0" encoding="utf-8"?>
<com.videoeditor.function.ad.FlowAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:clipChildren="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/title_prefix"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_alignLeft="@+id/title_name"
            android:layout_centerVertical="true"
            android:background="#52dfb2" />

        <TextView
            android:id="@+id/title_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/title_more"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:singleLine="true"
            android:text="Sponsored"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/title_more"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_marginLeft="20dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxWidth="50dp"
            android:singleLine="true"
            android:text="more"
            android:textColor="#cc000000"
            android:textSize="12sp" />

        <!-- <TextView
             android:id="@+id/title_more"
             android:layout_width="wrap_content"
             android:layout_height="match_parent"
             android:layout_alignParentEnd="true"
             android:layout_centerVertical="true"
             android:layout_marginEnd="20dp"
             android:layout_marginStart="20dp"
             android:text="@string/more"
             android:textColor="#cc000000"
             android:textSize="12sp"
             android:gravity="center"
             android:ellipsize="end"
             android:maxWidth="50dp"
             android:singleLine="true"
             android:fontFamily="sans-serif"/>-->
    </RelativeLayout>


    <FrameLayout
        android:id="@+id/ad_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_layout" />

</com.videoeditor.function.ad.FlowAdView>