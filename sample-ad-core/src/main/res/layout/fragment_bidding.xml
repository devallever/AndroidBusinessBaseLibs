<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Ad Bidding Demo (Parallel + Best Price)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <!-- Provider Registration -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Register Providers (with Bidding config)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnRegisterProviders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Register 3 Providers" />

            <!-- Initialization -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Initialize All Providers"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnInitAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚀 Initialize All (Join Pool)" />

            <!-- Load Mode Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: Select Load Mode"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeBidding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💰 BIDDING Mode"
                    android:textColor="#FF9800"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Mode: NOT SET"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:textStyle="bold" />

            <!-- Bidding Info -->
            <Button
                android:id="@+id/btnShowBiddingInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ℹ️ Show Bidding Providers Info"
                android:textSize="12sp" />

            <!-- Ad Operations -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: Load Ads (Parallel Bidding)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLoadInter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Interstitial"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnLoadReward"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Reward Video"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnShowInter"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📺 Show Interstitial Ad"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnShowReward"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📺 Show Reward Ad"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Status Display -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status &amp; Logs"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF3E0"
                android:padding="12dp"
                android:text="Ready to start bidding demo..."
                android:textSize="12sp"
                android:minHeight="200dp"
                android:gravity="top"
                android:fontFamily="monospace" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
