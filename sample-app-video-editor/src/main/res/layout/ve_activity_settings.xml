<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setting_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setting_activity_background"
    android:orientation="vertical">

    <!--- title bar -->
    <RelativeLayout
        android:id="@+id/rl_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_title_height"
        android:background="@color/title_bar_color">

        <com.android.absbase.ui.widget.RippleImageView
            android:id="@+id/setting_back"
            style="@style/default_icon_style"
            android:src="@drawable/icon_back" />

        <TextView
            style="@style/title_bar_title_style"
            android:text="@string/setting_title"/>

    </RelativeLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/setting_title"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingBottom="72dp">

            <com.allever.video.editor.ui.widget.SettingItem
                android:id="@+id/setting_premium"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setting_item_height"
                android:background="?attr/selectableItemBackground"
                app:check="true"
                app:checkable="false"
                app:lefticon="@drawable/icon_setting_premium"
                app:settingitemdesccolor="@color/setting_item_item_text_desc_color"
                app:settingitemtitle="@string/preferences_premium"
                app:settingitemtitlecolor="@color/setting_activity_item_text_color" />

            <include layout="@layout/setting_item_divider"/>

            <com.allever.video.editor.ui.widget.SettingItem
                android:id="@+id/setting_feedback"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setting_item_height"
                android:background="?attr/selectableItemBackground"
                app:check="true"
                app:checkable="false"
                app:lefticon="@drawable/icon_setting_feedback"
                app:settingitemdesccolor="@color/setting_item_item_text_desc_color"
                app:settingitemtitle="@string/setting_feedback"
                app:settingitemtitlecolor="@color/setting_activity_item_text_color" />

            <include layout="@layout/setting_item_divider"/>

            <com.allever.video.editor.ui.widget.SettingItem
                android:id="@+id/setting_about"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setting_item_height"
                android:background="?attr/selectableItemBackground"
                app:check="false"
                app:checkable="false"
                app:lefticon="@drawable/icon_setting_about"
                app:settingitemdesccolor="@color/setting_item_item_text_desc_color"
                app:settingitemtitle="@string/about"
                app:settingitemtitlecolor="@color/setting_activity_item_text_color" />

            <include layout="@layout/setting_item_divider"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>