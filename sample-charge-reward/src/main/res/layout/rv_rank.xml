<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="10dp"
    android:background="@drawable/ic_wd_level_bg_1"
    android:id="@+id/rootView">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftContainer"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/bgLeft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/ic_wd_level_bg_left_1" />

        <com.example.charge.ui.view.ShapeExtraWidthTextView
            android:id="@+id/tvLevel"
            style="@style/ExtraBoldText"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="$299"
            android:textColor="@color/color_9CFF54"
            android:textSize="30sp"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:shadowColor="@color/color_016C03"
            app:layout_constraintBottom_toBottomOf="@+id/bgLeft"
            app:layout_constraintEnd_toEndOf="@+id/bgLeft"
            app:layout_constraintStart_toStartOf="@+id/bgLeft"
            app:shape_textStrokeColor="@color/color_016C03"
            app:shape_textStrokeSize="2dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_marginBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/leftContainer"
        app:layout_constraintTop_toTopOf="parent">

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvCurrencyProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$130/$299"
            android:textColor="@color/color_00A203"
            android:textSize="23sp"
            android:lineSpacingExtra="-10dp"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:shadowColor="@color/color_40000000"
            app:layout_constraintBottom_toTopOf="@+id/progressBar"
            app:shape_textStrokeColor="@color/white"
            app:shape_textStrokeSize="2dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progressBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <View
                android:id="@+id/progressBg"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="@drawable/ic_wd_progress_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:layout_marginHorizontal="3dp"
                android:progressDrawable="@drawable/wd_rank_progress"
                app:layout_constraintBottom_toBottomOf="@+id/progressBg"
                app:layout_constraintEnd_toEndOf="@+id/progressBg"
                app:layout_constraintStart_toStartOf="@+id/progressBg"
                app:layout_constraintTop_toTopOf="@+id/progressBg"
                tools:progress="50" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.hjq.shape.view.ShapeTextView
            android:visibility="visible"
            android:id="@+id/tvRankInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="-8dp"
            android:text="@string/rank_info"
            android:textColor="@color/color_006AB5"
            app:layout_constraintBottom_toTopOf="@+id/progressBar" />

        <FrameLayout
            android:visibility="visible"
            android:id="@+id/btnRedeem"
            android:layout_width="94dp"
            android:layout_height="32dp"
            android:layout_marginVertical="0dp"
            android:paddingBottom="3dp"
            android:background="@drawable/ic_wd_rank_btn_redeem_disable"
            android:text="@string/redeem">

            <com.example.charge.ui.view.ShapeExtraWidthTextView
                style="@style/BoldText"
                android:layout_gravity="center"
                android:text="@string/redeem"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:shadowColor="@color/color_40000000"
                app:shape_textStrokeColor="@color/color_40000000"
                app:shape_textStrokeSize="2dp" />
        </FrameLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>