<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flGold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="20dp">

        <ImageView
            android:id="@+id/ivGoldBg"
            android:layout_width="133dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:src="@drawable/ic_currency_bg_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivGold"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_gold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGold"
            style="@style/ExtraBoldText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginEnd="10dp"
            android:singleLine="true"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="19sp"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeMinTextSize="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivGoldBg"
            app:layout_constraintStart_toEndOf="@+id/ivGold"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/flGold"
        android:layout_marginStart="26dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivGreenBg"
            android:layout_width="133dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:src="@drawable/ic_currency_bg_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivGreen"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGreen"
            style="@style/ExtraBoldText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginEnd="10dp"
            android:singleLine="true"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="19sp"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeMinTextSize="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivGreenBg"
            app:layout_constraintStart_toEndOf="@+id/ivGreen"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</merge>