<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/ic_task_charge_item_bg">

    <View
        android:id="@+id/bgLeft"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/ic_task_charge_item_bg_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_green"
        app:layout_constraintEnd_toEndOf="@+id/bgLeft"
        app:layout_constraintStart_toStartOf="@+id/bgLeft"
        app:layout_constraintTop_toTopOf="@+id/bgLeft" />

    <com.example.charge.ui.view.ShapeExtraWidthTextView
        android:id="@+id/tvGreen"
        style="@style/ExtraBoldText"
        android:layout_marginBottom="5dp"
        android:text="$1"
        android:textColor="@color/color_9CFF54"
        android:textSize="15sp"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:shadowColor="@color/color_016C03"
        app:layout_constraintBottom_toBottomOf="@+id/bgLeft"
        app:layout_constraintEnd_toEndOf="@+id/bgLeft"
        app:layout_constraintStart_toStartOf="@+id/bgLeft"
        app:shape_textStrokeColor="@color/color_016C03"
        app:shape_textStrokeSize="2dp" />

    <View
        android:id="@+id/btnActionLocation"
        android:layout_width="88dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/btnAction"
        android:layout_width="88dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/ic_task_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingBottom="2dp"
        app:layout_constraintTop_toTopOf="parent">

<!--        <ImageView-->
<!--            android:id="@+id/ivAdTag"-->
<!--            android:layout_width="20dp"-->
<!--            android:layout_height="20dp"-->
<!--            android:layout_marginHorizontal="2dp"-->
<!--            android:src="@drawable/ic_task_ad"-->
<!--            android:visibility="gone"/>-->

        <com.example.charge.ui.view.ShapeExtraWidthTextView
            android:id="@+id/tvAction"
            style="@style/BoldText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:text="@string/task_btn_state_claim"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:shadowColor="@color/color_016C03"
            app:layout_constraintBottom_toBottomOf="@+id/btnAction"
            app:layout_constraintEnd_toEndOf="@+id/btnAction"
            app:layout_constraintStart_toStartOf="@+id/btnAction"
            app:layout_constraintTop_toTopOf="@+id/btnAction"
            app:shape_textStrokeColor="@color/color_016C03"
            app:shape_textStrokeSize="2dp" />


    </LinearLayout>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tvTaskDesc"
        style="@style/BoldText"
        android:layout_width="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:text="@string/task_desc_charge_collect"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:shadowColor="@color/color_710ABE"
        app:layout_constraintEnd_toStartOf="@+id/btnAction"
        app:layout_constraintStart_toEndOf="@+id/bgLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_textStrokeColor="@color/color_710ABE"
        app:shape_textStrokeSize="2dp" />

    <View
        android:id="@+id/progressBg"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_task_charge_progress_bg"
        android:text="@string/task_desc_charge_collect"
        app:layout_constraintEnd_toStartOf="@+id/btnActionLocation"
        app:layout_constraintStart_toEndOf="@+id/bgLeft"
        app:layout_constraintTop_toBottomOf="@+id/tvTaskDesc"
        app:shape_textStrokeColor="@color/color_710ABE"
        app:shape_textStrokeSize="2dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        android:progress="0"
        android:progressDrawable="@drawable/task_charge_progress"
        app:layout_constraintBottom_toBottomOf="@+id/progressBg"
        app:layout_constraintEnd_toEndOf="@+id/progressBg"
        app:layout_constraintStart_toStartOf="@+id/progressBg"
        app:layout_constraintTop_toTopOf="@+id/progressBg"
        tools:progress="50" />

    <com.example.charge.ui.view.ShapeExtraWidthTextView
        android:id="@+id/tvProgressText"
        style="@style/BoldText"
        android:text="0/100"
        android:textColor="@color/color_00A203"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="@+id/progressBar"
        app:layout_constraintStart_toStartOf="@+id/progressBar"
        app:layout_constraintTop_toTopOf="@+id/progressBar"
        app:shape_textStrokeColor="@color/white"
        app:shape_textStrokeSize="2dp" />

    <ImageView
        android:id="@+id/ivFinish"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="7dp"
        android:src="@drawable/ic_task_finish"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>