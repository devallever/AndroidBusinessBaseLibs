<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_dialog_game_infinite"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goldCl"
        android:layout_width="180dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_dialog_ly"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.65">

        <ImageView
            android:id="@+id/goldImg"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/ic_game_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_marginBottom="17dp"
            android:src="@drawable/ic_infinite"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/goldImg"
            app:layout_constraintStart_toStartOf="@+id/goldImg" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/txt_infinite"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/ffd34002"
        app:layout_constraintBottom_toTopOf="@+id/seeAdLL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goldCl" />

    <LinearLayout
        android:id="@+id/seeAdLL"
        android:layout_width="148dp"
        android:layout_height="49dp"
        android:gravity="center"
        android:background="@drawable/bg_dialog_bt"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgImg">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_ad"/>

        <com.example.charge.ui.view.ShapeExtraWidthTextView
            style="@style/BoldText"
            android:text="@string/txt_sure"
            android:textSize="20sp"
            android:lines="1"
            android:gravity="center"
            android:textColor="@color/white"
            app:shape_textStrokeColor="@color/ff016c03"
            app:shape_textStrokeSize="2dp"
            android:shadowRadius="2"
            android:shadowDy="2"
            android:layout_marginStart="3dp"
            android:shadowColor="@color/ff016c03"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/closeImg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_dialog_close"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="@+id/bgImg"
        app:layout_constraintHorizontal_bias="0.913"
        app:layout_constraintStart_toStartOf="@+id/bgImg"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.208" />

    <com.example.charge.ui.view.NativeView
        android:id="@+id/naviteView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/seeAdLL"/>


</androidx.constraintlayout.widget.ConstraintLayout>