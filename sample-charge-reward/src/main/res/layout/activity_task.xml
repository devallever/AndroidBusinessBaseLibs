<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F5E8FF">

    <ImageView
        android:id="@+id/ivTopBg"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@drawable/ic_task_top_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.charge.ui.view.ShapeExtraWidthTextView
        android:id="@+id/tvTitle"
        style="@style/ExtraBoldText"
        android:padding="10dp"
        android:text="@string/task_list"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:shadowColor="@color/color_710ABE"
        app:layout_constraintBottom_toBottomOf="@+id/ivTopBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_textStrokeColor="@color/color_710ABE"
        app:shape_textStrokeSize="2dp" />

    <View
        android:id="@+id/tabBg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/ic_task_tab_container_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivTopBg" />


    <LinearLayout
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="-2dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/tabBg"
        app:layout_constraintEnd_toEndOf="@+id/tabBg"
        app:layout_constraintStart_toStartOf="@+id/tabBg"
        app:layout_constraintTop_toTopOf="@+id/tabBg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabCharge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ic_task_tab_charge">

            <com.hjq.shape.view.ShapeTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_charge"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:shadowColor="@color/color_710ABE"
                app:shape_textStrokeColor="@color/color_710ABE"
                app:shape_textStrokeSize="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabMole"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.hjq.shape.view.ShapeTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_mole"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:shadowColor="@color/color_710ABE"
                app:shape_textStrokeColor="@color/color_710ABE"
                app:shape_textStrokeSize="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabCoin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.hjq.shape.view.ShapeTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_coin"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:shadowColor="@color/color_710ABE"
                app:shape_textStrokeColor="@color/color_710ABE"
                app:shape_textStrokeSize="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab" />

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="35dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_page_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        tools:visibility="visible"
        android:id="@+id/tipsView"
        android:layout_width="212dp"
        android:layout_height="65dp"
        android:layout_gravity="center"
        android:background="@drawable/ic_task_claim_tip_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvObtain"
            style="@style/BoldText"
            android:text="@string/task_tips_obtain"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvGreen"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGreen"
            style="@style/BoldText"
            android:text="$1"
            android:textColor="@color/color_7BF22B"
            android:textSize="27sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvObtain"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>