<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootItem"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="7dp">

    <ImageView
        android:id="@+id/ivPayment"
        android:layout_width="78dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_pay_paypal_long"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivSelectFrame"
        android:layout_width="78dp"
        android:layout_height="52dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_payment_selected_bg"
        app:layout_constraintBottom_toBottomOf="@+id/ivPayment"
        android:layout_marginStart="-1dp"
        app:layout_constraintEnd_toEndOf="@+id/ivPayment"
        app:layout_constraintStart_toStartOf="@+id/ivPayment"
        app:layout_constraintTop_toTopOf="@+id/ivPayment" />

    <ImageView
        android:id="@+id/ivSelect"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="-6dp"
        android:background="@drawable/ic_payment_selected"
        app:layout_constraintEnd_toEndOf="@+id/ivPayment"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>