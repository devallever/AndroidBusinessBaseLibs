<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/hdc_actionBarColor"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="16dp"
            android:src="@drawable/hdc_ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T-1"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivInputType"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:padding="6dp"
            android:src="@drawable/hdc_ic_choose_dishes_menu_input_type_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivPreviewTicket"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="6dp"
            android:src="@drawable/hdc_ic_choose_dishes_menu_preview_order"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivInputType"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivPrintTicket"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="6dp"
            android:src="@drawable/hdc_ic_choose_dishes_menu_print_ticket_enable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivPreviewTicket"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- keyboard Type -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keyboardInputContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- 已添加 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/stateAdded"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="38dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/keyBoardContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/topPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <EditText
                    android:background="@null"
                    android:id="@+id/tvInput"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:singleLine="true"
                    android:maxLength="8"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/color_485ABE"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDishesName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tafelwasser 0,4l"
                    android:textSize="22sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvInput" />

                <TextView
                    android:id="@+id/tvInputTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hdc_choose_dishes_tips"
                    android:textColor="@color/color_969799"
                    android:textSize="20sp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChooseDishes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/topPanel"
                tools:itemCount="3"
                tools:listitem="@layout/hdc_item_choose_dishes" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/keyBoardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvAbc"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_abc"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvZero"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvZero"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_zero"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvAbc" />

            <TextView
                android:id="@+id/tvRemark"
                style="@style/hdc_transform_keyboard_text_style"
                android:background="@drawable/hdc_shape_keyboard_remark_disable_bg"
                android:text="@string/hdc_remark"
                android:textSize="18sp"
                android:clickable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvStar"
                app:layout_constraintStart_toEndOf="@+id/tvZero" />

            <!-- ok -->
            <TextView
                android:id="@+id/tvOk"
                style="@style/hdc_transform_keyboard_text_style"
                android:layout_height="0dp"
                android:background="@drawable/hdc_shape_keyboard_back_bg"
                android:text="@string/hdc_ok"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvRemark"
                app:layout_constraintTop_toTopOf="@+id/tvThree" />

            <!-- 出单 make order -->
            <TextView
                android:id="@+id/tvMakeOrder"
                style="@style/hdc_transform_keyboard_text_style"
                android:layout_height="0dp"
                android:background="@drawable/hdc_shape_keyboard_make_order_bg"
                android:text="@string/hdc_make_order"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvRemark"
                app:layout_constraintTop_toTopOf="@+id/tvThree" />

            <TextView
                android:id="@+id/tvOne"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_one"
                app:layout_constraintBottom_toTopOf="@+id/tvAbc"
                app:layout_constraintEnd_toStartOf="@+id/tvZero"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvTwo"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_two"
                app:layout_constraintBottom_toTopOf="@+id/tvAbc"
                app:layout_constraintEnd_toStartOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvAbc" />

            <TextView
                android:id="@+id/tvThree"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_three"
                app:layout_constraintBottom_toTopOf="@+id/tvAbc"
                app:layout_constraintEnd_toEndOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvTwo" />


            <TextView
                android:id="@+id/tvFour"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_four"
                app:layout_constraintBottom_toTopOf="@+id/tvOne"
                app:layout_constraintEnd_toStartOf="@+id/tvZero"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvFive"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_five"
                app:layout_constraintBottom_toTopOf="@+id/tvOne"
                app:layout_constraintEnd_toStartOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvAbc" />

            <TextView
                android:id="@+id/tvSix"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_six"
                app:layout_constraintBottom_toTopOf="@+id/tvOne"
                app:layout_constraintEnd_toEndOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvTwo" />

            <ImageView
                android:id="@+id/ivDelete"
                style="@style/hdc_transform_keyboard_text_style"
                android:scaleType="centerInside"
                android:src="@drawable/hdc_ic_keyboard_delete"
                app:layout_constraintBottom_toTopOf="@+id/tvOne"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvRemark" />


            <TextView
                android:id="@+id/tvSeven"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_seven"
                app:layout_constraintBottom_toTopOf="@+id/tvFour"
                app:layout_constraintEnd_toStartOf="@+id/tvZero"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvEight"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_eight"
                app:layout_constraintBottom_toTopOf="@+id/tvFour"
                app:layout_constraintEnd_toStartOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvAbc" />

            <TextView
                android:id="@+id/tvNight"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_night"
                app:layout_constraintBottom_toTopOf="@+id/tvFour"
                app:layout_constraintEnd_toEndOf="@+id/tvRemark"
                app:layout_constraintStart_toEndOf="@+id/tvTwo" />

            <TextView
                android:id="@+id/tvStar"
                style="@style/hdc_transform_keyboard_text_style"
                android:text="@string/hdc_star"
                app:layout_constraintBottom_toTopOf="@+id/tvFour"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvRemark" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- selector Type -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectorInputContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/color_F5F7FA"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/hdc_shadow_line"
            app:layout_constraintTop_toBottomOf="@+id/rvSecondSort" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSecondSort"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="1"
            tools:listitem="@layout/hdc_item_dishes_second_sort" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvThirdSort"
            android:layout_width="100dp"
            android:layout_height="0dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvSecondSort"
            tools:listitem="@layout/hdc_item_dishes_third_sort" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDishes"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/rvThirdSort"
            app:layout_constraintTop_toBottomOf="@+id/rvSecondSort"
            tools:itemCount="3"
            tools:listitem="@layout/hdc_item_selector_dishes" />

        <View
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:background="@drawable/hdc_shadow_line"
            app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/rvDishes" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomContainer"
            android:layout_width="0dp"
            app:layout_constraintStart_toEndOf="@+id/rvThirdSort"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="96dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvSelectorMakeOrder"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="50dp"
            android:background="@drawable/hdc_shape_gray_r45"
            android:gravity="center"
            android:text="@string/hdc_make_order"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/bottomContainer"
            app:layout_constraintEnd_toEndOf="@+id/bottomContainer"
            app:layout_constraintStart_toStartOf="@+id/rvDishes"
            app:layout_constraintTop_toTopOf="@+id/bottomContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>