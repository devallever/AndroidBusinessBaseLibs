<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <TextView
        android:id="@+id/tvCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="3dp"
        android:layout_weight="1"
        android:text="1x"
        android:textColor="@color/color_282929"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTaxSign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="3dp"
        android:layout_weight="1"
        android:text="A"
        android:textColor="@color/color_282929"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="3dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:text="3,99"
        android:textColor="@color/color_282929"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTaxSign"
        app:layout_constraintEnd_toStartOf="@+id/tvTaxSign"
        app:layout_constraintTop_toTopOf="@+id/tvTaxSign" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="3dp"
        android:text="Mineralwasser Sprudel 0.75l (6,90)\nMineralwasser Sprudel 0.75l (6,90)\nMineralwasser Sprudel 0.75l (6,90)"
        android:textColor="@color/color_282929"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvCost"
        app:layout_constraintStart_toEndOf="@+id/tvCount"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>