<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/includeTopBar"
        layout="@layout/hdc_include_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/includeTopBar">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hdc_old_pin"
            android:textColor="@color/color_282929"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:inputType="number"
            android:id="@+id/etOldPin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/hdc_shape_gray_frame"
            android:hint="@string/hdc_old_pin_hint"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="@color/color_282929"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hdc_new_pin"
            android:textColor="@color/color_282929"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:inputType="number"
            android:id="@+id/etNewPin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/hdc_shape_gray_frame"
            android:hint="@string/hdc_new_pin_hint"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="@color/color_282929"
            android:textSize="16sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hdc_new_pin_confirm"
            android:textColor="@color/color_282929"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:inputType="number"
            android:id="@+id/etNewPinConfirm"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/hdc_shape_gray_frame"
            android:hint="@string/hdc_new_pin_confirm_hint"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="@color/color_282929"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/hdc_shape_blue_r45"
            android:gravity="center"
            android:text="@string/hdc_ok"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>