<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="295dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg_white">

    <TextView
        android:id="@+id/btnDeleteTodayBefore"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:foreground="@drawable/ripple_effect"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="删除今日之前所有数据"
        android:textColor="@color/color_485ABE"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_282929" />

    <TextView
        android:id="@+id/btnDeleteToday"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:foreground="@drawable/ripple_effect"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="删除今日所有数据"
        android:textColor="@color/color_485ABE"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_282929" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:foreground="@drawable/ripple_effect"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="取消"
        android:textColor="@color/color_485ABE"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_282929" />

</LinearLayout>