<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="295dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/hdc_dialog_bg_white"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCurrentTable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hdc_current_table"
        android:textColor="@color/color_282929"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/hdc_ic_dialog_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hdc_trans_table_tips"
        android:textColor="@color/color_646566"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCurrentTable" />

    <TextView
        android:id="@+id/btnTransform"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/hdc_shape_blue_frame_r45"
        android:gravity="center"
        android:text="@string/hdc_transform"
        android:textColor="@color/color_485ABE"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/btnDelete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTips" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/hdc_shape_gray_frame_r45"
        android:gravity="center"
        android:text="@string/hdc_delete"
        android:textColor="@color/color_646566"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnTransform"
        app:layout_constraintTop_toBottomOf="@+id/tvTips" />

</androidx.constraintlayout.widget.ConstraintLayout>