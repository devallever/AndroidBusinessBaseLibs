<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="hdc_Theme.HDCalculator" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/hdc_colorPrimary</item>
        <item name="colorPrimaryDark">@color/hdc_colorPrimaryDark</item>
    </style>

    <style name="hdc_Theme.Calculator" parent="Theme.AppCompat.Light.NoActionBar">
    </style>

    <style name="hdc_calc_text_style">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_282929</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_margin">0.5dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
    </style>

    <style name="hdc_main_menu_text_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">@color/color_282929</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="hdc_main_menu_item_container">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="hdc_transform_keyboard_text_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">90dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/hdc_shape_gray_frame_w0_5</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_282929</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="hdc_modify_dishes_keyboard_text_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">90dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/hdc_shape_gray_frame_w0_5</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_282929</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="hdc_choose_dishes_keyboard_text_style">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_282929</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">90dp</item>
        <item name="android:background">@drawable/hdc_shape_gray_frame_w0_5</item>

    </style>

    <color name="color_282929">#282929</color>
</resources>