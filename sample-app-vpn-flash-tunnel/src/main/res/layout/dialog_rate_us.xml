<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivDialogBg"
        android:layout_width="match_parent"
        android:layout_height="416dp"
        android:layout_marginBottom="0dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/icon_rate_dialog_bg"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="154dp"
        android:layout_height="154dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/icon_dialog_rate_us"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginVertical="8dp"
        android:layout_marginBottom="20dp"
        android:numStars="5"
        android:progressDrawable="@drawable/rate_us_drawable"
        android:rating="5"
        android:stepSize="1"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:paddingHorizontal="20dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="56dp"
        android:gravity="center"
        android:textColor="@color/color_005FFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirm"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingBar"
        android:text="@string/dialog_rate_us_message" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirm"
        android:layout_width="164dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="54dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/icon_dialog_btn"
        android:foreground="@drawable/ripple_default"
        android:text="@string/ok"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivDialogBg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>