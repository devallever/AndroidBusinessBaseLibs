<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_append_time_dialog_bg">

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tvMessage" />


    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="26dp"
        android:gravity="center"
        android:paddingTop="20dp"
        android:text="@string/dialog_add_time_message"
        android:textColor="@color/color_005FFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirm" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="54dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/icon_dialog_btn"
        android:foreground="@drawable/ripple_default"
        android:text="@string/ok"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>