<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 视频显示区域（渲染器会在此容器中添加视图）-->
    <FrameLayout
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/containerVideoOld"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#222222"
        android:layout_marginBottom="4dp">

        <!-- 渲染器会动态将 SurfaceView/TextureView/VideoView 添加到此处 -->
        <app.allever.android.lib.player.core.player.StdVideoPlayer
            android:id="@+id/stdVideoPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 视频尺寸信息覆盖层 -->
        <TextView
            android:id="@+id/tvVideoSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#80000000"
            android:padding="4dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            tools:text="1920x1080" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        app:layout_constraintTop_toBottomOf="@+id/containerVideoOld"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StdVideoPlayer 示例（引擎/渲染/UI分离架构）"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:layout_marginBottom="12dp" />

            <!-- 架构信息 -->
            <TextView
                android:id="@+id/tvArchInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前组合: MediaPlayerEngine + SurfaceViewRender"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <!-- ==================== 渲染器切换（新架构核心功能演示）==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="渲染器切换（运行时动态切换）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnSwitchSurfaceView"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="SurfaceView"
                    android:textSize="12sp"
                    android:enabled="false"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSwitchTextureView"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="TextureView"
                    android:textSize="12sp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSwitchVideoView"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="VideoView"
                    android:textSize="12sp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSwitchPlayerView"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="PlayerView"
                    android:textSize="12sp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <!-- ==================== 引擎切换（新架构核心功能演示）==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="引擎切换（运行时动态切换）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnSwitchMediaPlayer"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="MediaPlayer"
                    android:textSize="11sp"
                    android:enabled="false"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnSwitchMedia3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Media3(Exo)"
                    android:textSize="11sp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnSwitchIjkPlayer"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="IJKPlayer"
                    android:textSize="11sp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <!-- 状态显示 -->
            <TextView
                android:id="@+id/tvState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: IDLE"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnPickLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择本地视频"
                android:layout_marginBottom="16dp" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="16dp" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="16dp" />

            <!-- 日志输出区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运行日志"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="清空日志"
                    android:textSize="12sp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#F5F5F5"
                android:padding="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    tools:text="日志输出..." />
            </ScrollView>

            <!-- 测试URL输入 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频URL（留空使用默认测试视频）"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="https://example.com/video.mp4"
                    android:inputType="textUri"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnPlayNet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放网络视频" />
            </LinearLayout>


            <!-- Assets文件播放 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assets 文件路径（相对路径，如 video/test.mp4）"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etAssetPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="video/test.mp4"
                    android:text="output.mp4"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPlayAsset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放Assets" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

