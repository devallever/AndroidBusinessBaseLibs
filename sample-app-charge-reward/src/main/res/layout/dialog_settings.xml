<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/bgImg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_dialog_settings"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/shapeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="70dp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/settings"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:autoSizeMaxTextSize="24sp"
        app:autoSizeMinTextSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.03"
        app:shape_textStrokeColor="@color/ff9c1a00"
        app:shape_textStrokeSize="3dp"
        tools:layout_editor_absoluteX="70dp" />


    <ImageView
        android:id="@+id/closeImg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_dialog_close"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="@+id/bgImg"
        app:layout_constraintHorizontal_bias="0.955"
        app:layout_constraintStart_toStartOf="@+id/bgImg"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.043" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goldCl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/bg_idalog_settings_ly"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintDimensionRatio="h,259:94"
        app:layout_constraintEnd_toEndOf="@+id/bgImg"
        app:layout_constraintStart_toStartOf="@+id/bgImg"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.363">

        <ImageView
            android:id="@+id/voiceImg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_music"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/musicImg"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/voiceOffImg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="26dp"
            android:src="@drawable/ic_setting_off"
            app:layout_constraintStart_toStartOf="@+id/voiceImg"
            app:layout_constraintTop_toTopOf="@+id/voiceImg" />

        <ImageView
            android:id="@+id/musicImg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_voice"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/voiceImg"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/musicOffImg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="26dp"
            android:src="@drawable/ic_setting_off"
            app:layout_constraintStart_toStartOf="@+id/musicImg"
            app:layout_constraintTop_toTopOf="@+id/musicImg" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/termsTv"
        app:layout_constraintEnd_toEndOf="@+id/goldCl"
        app:layout_constraintStart_toStartOf="@+id/goldCl"
        app:layout_constraintTop_toBottomOf="@+id/goldCl">

        <LinearLayout
            android:id="@+id/englishLL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/englishImg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_select" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:text="@string/english"
                android:textColor="@color/ffd34002"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barsilLL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brazilImg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_unselect" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:text="@string/brazil"
                android:textColor="@color/ffd34002"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/termsTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/ffd34002"
        android:textSize="16sp"
        android:text="@string/feedBook"
        app:layout_constraintBottom_toTopOf="@+id/privacyTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <TextView
        android:id="@+id/privacyTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/privacy"
        android:textColor="@color/ffd34002"
        android:textSize="16sp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/termsTv" />


</androidx.constraintlayout.widget.ConstraintLayout>