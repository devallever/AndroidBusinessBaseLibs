<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/bgImg"
        android:layout_width="match_parent"
        android:layout_height="248dp"
        android:layout_marginHorizontal="35dp"
        android:background="@drawable/ic_dialog_empty_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hjq.shape.view.ShapeImageView
        android:id="@+id/ivIcon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_pay_paypal"
        app:shape_strokeSize="1dp"
        app:shape_radius="12dp"
        android:padding="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tvTips"
        style="@style/BoldText"
        android:layout_width="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/input_correct_info"
        android:textColor="@color/color_D34002"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/bgImg"
        app:layout_constraintStart_toStartOf="@+id/bgImg"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon" />


    <FrameLayout
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ic_dialog_input_bg"
        app:layout_constraintEnd_toEndOf="@+id/bgImg"
        app:layout_constraintStart_toStartOf="@+id/bgImg"
        app:layout_constraintTop_toBottomOf="@+id/tvTips">

        <com.hjq.shape.view.ShapeEditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:hint="@string/input_cpf"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingHorizontal="16dp"
            android:fontFamily="@font/baloobhai2_bold"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textColorHint="#FFC07900" />
    </FrameLayout>

    <View
        android:id="@+id/btnOk"
        android:layout_width="148dp"
        android:layout_height="49dp"
        android:layout_marginTop="-30dp"
        android:background="@drawable/bg_dialog_bt"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgImg" />

    <com.example.charge.ui.view.ShapeExtraWidthTextView
        style="@style/BoldText"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:lines="1"
        android:shadowColor="@color/ff016c03"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:text="@string/ok"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/btnOk"
        app:layout_constraintEnd_toEndOf="@+id/btnOk"
        app:layout_constraintStart_toStartOf="@+id/btnOk"
        app:layout_constraintTop_toTopOf="@+id/btnOk"
        app:shape_textStrokeColor="@color/ff016c03"
        app:shape_textStrokeSize="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>