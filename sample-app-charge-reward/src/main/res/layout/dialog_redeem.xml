<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_dialog_view"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/clickNumLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:layout_width="43dp"
            android:layout_height="46dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_mole"
            android:visibility="gone" />

        <com.example.charge.ui.view.ShapeExtraWidthTextView
            android:id="@+id/clickNumTv"
            style="@style/BoldText"
            android:layout_gravity="center_vertical"
            android:shadowColor="@color/ff9c1a00"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="@string/obtain"
            android:textColor="@color/white"
            android:textSize="23sp"
            app:shape_textStrokeColor="@color/ff9c1a00"
            app:shape_textStrokeSize="2dp" />
    </LinearLayout>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/getDoubleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:shadowColor="@color/ff9c1a00"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:text="获得3倍"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.45"
        app:shape_textStrokeColor="@color/ff9c1a00"
        app:shape_textStrokeSize="1dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goldCl"
        android:layout_width="202dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_dialog_ly"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.8">

        <ImageView
            android:id="@+id/greenImg"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/ic_green_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.example.charge.ui.view.ShapeExtraWidthTextView
            android:id="@+id/tvGreen"
            style="@style/ExtraBoldText"
            android:layout_gravity="center_horizontal|bottom"
            android:shadowColor="@color/ff016c03"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="$ 1"
            android:textColor="@color/ff9cff54"
            android:textSize="20sp"
            app:layout_constraintBaseline_toBottomOf="@id/greenImg"
            app:layout_constraintEnd_toEndOf="@+id/greenImg"
            app:layout_constraintStart_toStartOf="@+id/greenImg"
            app:shape_textStrokeColor="@color/ff016c03"
            app:shape_textStrokeSize="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/btnOk"
        android:layout_width="156dp"
        android:layout_height="49dp"
        android:background="@drawable/bg_dialog_bt"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgImg">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_ad"
            android:visibility="gone" />

        <com.example.charge.ui.view.ShapeExtraWidthTextView
            style="@style/BoldText"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:lines="1"
            android:shadowColor="@color/ff016c03"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="23sp"
            app:shape_textStrokeColor="@color/ff016c03"
            app:shape_textStrokeSize="1dp" />

    </LinearLayout>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/getAwareTv"
        android:layout_width="156dp"
        android:layout_height="49dp"
        android:background="@drawable/bg_dialog_bt"
        android:gravity="center"
        android:lines="1"
        android:orientation="horizontal"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:text="确定"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgImg"
        app:shape_textStrokeColor="@color/ff016c03"
        app:shape_textStrokeSize="2dp" />

    <ImageView
        android:id="@+id/closeImg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_dialog_close"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="@+id/bgImg"
        app:layout_constraintHorizontal_bias="0.913"
        app:layout_constraintStart_toStartOf="@+id/bgImg"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.208" />

    <View
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnOk" />

</androidx.constraintlayout.widget.ConstraintLayout>