<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_dialog_new_user_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/clickNumLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.38">

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/clickNumTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:shadowColor="@color/ff9c1a00"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="@string/dialog_new_user_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:shape_textStrokeColor="@color/ff9c1a00"
            app:shape_textStrokeSize="3dp" />
    </LinearLayout>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/getDoubleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:shadowColor="@color/ff9c1a00"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:text="获得3倍"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.45"
        app:shape_textStrokeColor="@color/ff9c1a00"
        app:shape_textStrokeSize="1dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goldCl"
        android:layout_width="180dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_dialog_ly"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImg"
        app:layout_constraintVertical_bias="0.62">

        <ImageView
            android:id="@+id/greenImg"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/ic_dialog_new_user_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.example.charge.ui.view.ShapeExtraWidthTextView
        android:id="@+id/tvGreen"
        style="@style/ExtraBoldText"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginTop="8dp"
        android:shadowColor="@color/color_FF3706"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:text=" $ 3.1 "
        android:textColor="@color/white"
        android:textSize="31sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goldCl"
        app:shapeExtraWidth="10dp"
        app:shape_textStrokeColor="@color/color_FF3706"
        app:shape_textStrokeSize="5dp" />

    <TextView
        style="@style/SemiBoldText"
        android:layout_width="0dp"
        android:layout_marginHorizontal="80dp"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:lineSpacingExtra="-8dp"
        android:text="@string/dialog_new_user_info"
        android:textColor="@color/color_D34002"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGreen" />

    <View
        android:id="@+id/btnOk"
        android:layout_width="156dp"
        android:layout_height="49dp"
        android:background="@drawable/bg_dialog_bt"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgImg">

    </View>

    <com.example.charge.ui.view.ShapeExtraWidthTextView
        app:layout_constraintTop_toTopOf="@+id/btnOk"
        app:layout_constraintBottom_toBottomOf="@+id/btnOk"
        app:layout_constraintStart_toStartOf="@+id/btnOk"
        app:layout_constraintEnd_toEndOf="@+id/btnOk"
        style="@style/BoldText"
        android:layout_marginStart="5dp"
        android:gravity="center"
        android:lines="1"
        android:shadowColor="@color/ff016c03"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:text="@string/task_btn_state_claim"
        android:textColor="@color/white"
        android:textSize="23sp"
        app:shape_textStrokeColor="@color/ff016c03"
        app:shape_textStrokeSize="3dp" />

    <FrameLayout
        android:id="@+id/getAwareTv"
        android:layout_width="156dp"
        android:layout_height="49dp"
        android:background="@drawable/bg_dialog_bt"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/bgImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgImg">

        <com.hjq.shape.view.ShapeTextView
            android:layout_width="156dp"
            android:layout_height="49dp"
            android:gravity="center"
            android:lines="1"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="确定"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:shape_textStrokeColor="@color/ff016c03"
            app:shape_textStrokeSize="2dp" />
    </FrameLayout>

    <com.example.charge.ui.view.NativeView
        android:id="@+id/naviteView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnOk" />


</androidx.constraintlayout.widget.ConstraintLayout>