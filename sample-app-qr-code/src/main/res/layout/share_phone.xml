<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/share_phone_container">

    <app.allever.android.ai.qr.scanner.ui.widget.ShareItemInput
        android:id="@+id/id_share_item_input_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/share_item_input_margin_right_left"
        android:layout_marginLeft="@dimen/share_item_input_margin_right_left"
        app:siiMaxContentLength="20"
        app:siiHint="@string/scene_edit_hint_phone_number"
        app:siiTitle="@string/scene_edit_title_phone_number"
        app:siiInputType="number"/>

</ScrollView>