<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/id_tv_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:textColor="@color/qr_share_item_tv_title_color"/>

    <EditText
        android:id="@+id/id_et_content"
        android:theme="@style/qr_MyShareItemEditText"
        style="@style/qr_ShareItemEtInputStyle" />

    <TextView
        android:id="@+id/id_tv_length_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text=""
        android:textSize="12sp"
        android:layout_gravity="right"
        android:textColor="@color/qr_share_item_tv_input_index"/>

</LinearLayout>