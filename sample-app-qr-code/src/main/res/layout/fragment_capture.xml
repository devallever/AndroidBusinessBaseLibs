<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.zxing.client.android.ViewfinderView
        android:id="@+id/viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <TextView
        android:id="@+id/status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginTop="45dp"
        android:text="@string/main_scan_tips"
        android:textColor="@color/main_status_text_color"
        android:textSize="12sp" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/camera_zoom_far"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/icon_zoom_out" />

        <SeekBar
            android:id="@+id/camera_zoom_seekbar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:progressDrawable="@drawable/seekbar_layer"
            android:thumb="@drawable/seekbar_dot" />

        <ImageView
            android:id="@+id/camera_zoom_near"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/icon_zoom_in" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_flashlight"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/main_bottom_btn_background"
            android:scaleType="centerInside"
            android:src="@drawable/icon_flashlight" />

        <ImageView
            android:id="@+id/btnRecommend"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="18dp"
            android:tint="@color/white"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/main_bottom_btn_background"
            android:scaleType="centerInside"
            android:visibility="gone"/>

        <ImageView
            android:visibility="gone"
            android:id="@+id/btn_premium"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/main_bottom_btn_background"
            android:scaleType="centerInside"
            android:src="@drawable/icon_crown" />
        <ImageView
            android:id="@+id/btn_album"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/main_bottom_btn_background"
            android:scaleType="centerInside"
            android:src="@drawable/icon_photo"
            android:visibility="gone"/>
    </LinearLayout>

    <include layout="@layout/loading_progress_view"/>

</RelativeLayout>
