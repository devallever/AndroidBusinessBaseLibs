                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name="app.allever.android.ai.qr.scanner.ui.HistoryActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"/>
        <activity android:name="app.allever.android.ai.qr.scanner.ui.SettingActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"/>

