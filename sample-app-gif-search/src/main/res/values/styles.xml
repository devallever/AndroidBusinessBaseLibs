<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/gs_colorPrimary</item>
        <item name="colorPrimaryDark">@color/gs_colorPrimaryDark</item>
        <item name="colorAccent">@color/gs_colorAccent</item>
    </style>

    <!-- 全屏 -->
    <style name="FullScreenStyle" parent="Theme.AppCompat.Light.NoActionBar">
<!--        <item name="android:windowNoTitle">true</item>-->
<!--        <item name="windowActionBar">false</item>-->
<!--        <item name="android:windowFullscreen">true</item>-->
    </style>


    <!-- Setting -->
    <style name="setting_item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?actionBarSize</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

</resources>
