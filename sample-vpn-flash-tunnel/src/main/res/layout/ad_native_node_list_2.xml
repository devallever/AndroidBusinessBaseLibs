<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_margin="0dp">


        <ImageView
            android:id="@+id/icon"
            android:layout_marginStart="20dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/primary"
            style="@style/defaultTextStyle"
            android:layout_width="0dp"
            android:maxLines="1"
            tools:text="Ad: Title"
            android:layout_marginStart="12dp"
            android:textColor="@color/gnt_black"
            app:layout_constraintBottom_toTopOf="@+id/starContainer"
            app:layout_constraintLeft_toRightOf="@+id/icon"
            app:layout_constraintRight_toLeftOf="@+id/cta"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="@+id/icon"
            android:layout_marginVertical="6dp"
            app:layout_constraintVertical_chainStyle="packed" />

        <LinearLayout
            android:layout_marginVertical="6dp"
            android:orientation="horizontal"
            android:id="@+id/starContainer"
            style="@style/superSmallTextStyle"
            android:text="the_fastest_server"
            android:textColor="@color/color_CCFFFFFF"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintLeft_toLeftOf="@id/primary"
            app:layout_constraintTop_toBottomOf="@+id/primary"
            app:layout_constraintVertical_chainStyle="packed">


            <TextView
                android:id="@+id/ad_notification_view"
                android:layout_width="@dimen/gnt_ad_indicator_width"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gnt_no_margin"
                android:layout_marginTop="@dimen/gnt_ad_indicator_top_margin"
                android:layout_marginEnd="@dimen/gnt_default_margin"
                android:background="@drawable/gnt_rounded_corners_shape"
                android:gravity="center"
                android:text="Ad"
                android:textColor="@color/gnt_ad_green"
                android:textSize="@dimen/gnt_ad_indicator_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RatingBar
                android:id="@+id/rating_bar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gnt_no_margin"
                android:layout_marginTop="@dimen/gnt_no_margin"
                android:layout_marginEnd="@dimen/gnt_no_margin"
                android:layout_marginBottom="@dimen/gnt_no_margin"
                android:background="@android:color/transparent"
                android:lines="1"
                android:numStars="5"
                android:stepSize="0.1"
                android:textColor="@color/gnt_gray"
                android:textSize="@dimen/gnt_text_size_small">

            </RatingBar>


        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cta"
            android:layout_width="80dp"
            android:layout_height="42dp"
            android:padding="4dp"
            android:maxLines="2"
            tools:text="Install"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@drawable/shape_ad_btn"
            android:gravity="center"
            android:lines="2"
            android:layout_marginEnd="20dp"
            android:textSize="12sp"
            android:textColor="@color/gnt_black" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</com.google.android.gms.ads.nativead.NativeAdView>