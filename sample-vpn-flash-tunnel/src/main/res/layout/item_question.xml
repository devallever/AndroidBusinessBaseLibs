<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/qa_item_bg"
    android:foreground="@drawable/ripple_default"
    android:minHeight="56dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuestion"
        style="@style/defaultTextStyle"
        android:layout_width="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:singleLine="true"
        android:text="FAQ1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ivExpand"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_33FFFFFF" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAnswer"
        style="@style/smallTextStyle"
        android:layout_width="0dp"
        android:layout_marginTop="12dp"
        android:text="Answer"
        android:textColor="@color/color_CCFFFFFF"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="@+id/tvQuestion"
        app:layout_constraintRight_toRightOf="@+id/tvQuestion"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestion" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivExpand"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:padding="10dp"
        android:src="@drawable/icon_arrow_up_24"
        app:layout_constraintBottom_toBottomOf="@+id/tvQuestion"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvQuestion" />

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvAnswer" />

</androidx.constraintlayout.widget.ConstraintLayout>