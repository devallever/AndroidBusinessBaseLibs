<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/icon_page_bg" />

    <View
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <TextView
        style="@style/defaultTextStyle"
        android:text="@string/success"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/topBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topBar" />

    <ImageView
        android:foreground="@drawable/ripple_default"
        android:id="@+id/ivClose"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="16dp"
        android:src="@drawable/icon_close_24"
        app:layout_constraintBottom_toBottomOf="@+id/topBar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topBar" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_marginTop="88dp"
                android:src="@drawable/icon_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFlag"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/icon_default_region" />

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/defaultTextStyle"
                    android:layout_marginHorizontal="5dp"
                    android:text="00:00:00"
                    android:textColor="@color/color_00EBFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                style="@style/smallTextStyle"
                android:layout_marginTop="16dp"
                android:text="Connection completed."
                android:textColor="@color/color_CCFFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp">


                <View
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/btnAddTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/btn_add_time_bg"
                    android:foreground="@drawable/ripple_default" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAddTime"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="24dp"
                    android:src="@drawable/icon_add_time_24"
                    app:layout_constraintBottom_toBottomOf="@+id/btnAddTime"
                    app:layout_constraintLeft_toLeftOf="@+id/btnAddTime"
                    app:layout_constraintTop_toTopOf="@+id/btnAddTime" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/defaultTextStyle"
                    android:layout_marginStart="8dp"
                    android:text="@string/add_time"
                    app:layout_constraintBottom_toBottomOf="@+id/btnAddTime"
                    app:layout_constraintLeft_toRightOf="@+id/ivAddTime"
                    app:layout_constraintTop_toTopOf="@+id/btnAddTime" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="24dp"
                    android:src="@drawable/icon_more_24"
                    app:layout_constraintBottom_toBottomOf="@+id/btnAddTime"
                    app:layout_constraintRight_toRightOf="@+id/btnAddTime"
                    app:layout_constraintTop_toTopOf="@+id/btnAddTime" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <FrameLayout
                android:id="@+id/adContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="48dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="1dp"
                android:layout_marginTop="50dp" />

        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>